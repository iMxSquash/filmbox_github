# Copier en .env (jamais commité) et remplacer les mots de passe.

# Base (compte d'administration : migrations uniquement)
POSTGRES_DB=filmbox
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-moi
DB_PORT=5433

# Compte de connexion de l'application (membre du groupe filmbox_app, M16.1)
FILMBOX_APP_USER=filmbox_web
FILMBOX_APP_PASSWORD=change-moi-aussi

# Chaîne de connexion utilisée par l'application : jamais le compte postgres
DATABASE_URL=postgres://filmbox_web:change-moi-aussi@127.0.0.1:5433/filmbox

# Secret de signature des sessions (32 caractères minimum) : openssl rand -base64 48
SESSION_SECRET=
